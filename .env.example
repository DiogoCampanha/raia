# Copy this file to `.env` and fill in your values.

# --- LLM provider ----------------------------------------------------------
# "anthropic" (default) | "openai" | "mock" (no API key needed; canned output)
RAIA_LLM_PROVIDER=anthropic
RAIA_LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=sk-ant-...

# For OpenAI instead:
# RAIA_LLM_PROVIDER=openai
# RAIA_LLM_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# --- Users, projects and storage ------------------------------------------
# Locally nothing is needed: a SQLite file under the workspace holds users and
# projects, each project's blackboard is a Git repository, and sign-in uses a
# fixed local developer identity.
# RAIA_DATABASE_URL=postgresql://raia:raia@localhost:5432/raia   # use PostgreSQL instead
# RAIA_STORE=database        # git | database (database is the default with PostgreSQL)
# RAIA_AUTH=dev              # dev | google
# RAIA_DEV_USER_EMAIL=developer@raia.local
# RAIA_ADMIN_EMAILS=you@example.com
# RAIA_MAX_RUNS_PER_DAY=60

# --- Optional tuning ---------------------------------------------------------
# RAIA_LLM_TEMPERATURE=0.2
# RAIA_LLM_MAX_TOKENS=4096
# RAIA_RAG_TOP_K=6
# RAIA_WORKSPACE_DIR=./workspace

# --- Reliability and analysis thresholds -----------------------------------
# Transient provider failures (overload, rate limit, timeout) are retried with
# backoff. Nothing else is retried.
RAIA_LLM_RETRIES=2

# Retrieval budget. Each agent additionally pins the excerpts its decision
# procedure depends on, so the decisive text is never dropped by similarity.
RAIA_RAG_TOP_K=12

# Below this many observations, a per-group fairness figure is reported but
# labelled as too small to support a conclusion.
RAIA_MIN_GROUP_SAMPLES=30

# Used only when no approved artifact defines a fairness threshold.
RAIA_DEFAULT_PARITY_THRESHOLD=0.1
