# Copy this file to `.env` and fill in your values.

# --- LLM provider ----------------------------------------------------------
# "anthropic" (default) | "openai" | "mock" (no API key needed; canned output).
# Both provider libraries are installed: switching is a configuration change.
RAIA_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# The model defaults per provider: claude-sonnet-5-5 (anthropic), gpt-6.2-sol (openai).
# RAIA_LLM_MODEL=claude-sonnet-5-5

# For OpenAI instead:
# RAIA_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# RAIA_LLM_MODEL=gpt-6.2-sol

# No temperature is sent by default: Claude Sonnet 5.5 and OpenAI's reasoning
# models refuse one. Set a number only for a model that accepts it; if it is
# refused anyway, RAIA retries without it. Provenance records what was sent.
# RAIA_LLM_TEMPERATURE=0.2

# --- Users, projects and storage ------------------------------------------
# Locally nothing is needed: a SQLite file under the workspace holds users and
# projects, each project's blackboard is a Git repository, and sign-in uses a
# fixed local developer identity.
# RAIA_DATABASE_URL=postgresql://raia:raia@localhost:5432/raia   # use PostgreSQL instead
# RAIA_STORE=database        # git | database (database is the default with PostgreSQL)
# Sign-in. "dev" signs you in as one fixed local identity and must be chosen
# explicitly: an app with neither this line nor Google sign-in refuses to open.
RAIA_AUTH=dev                # dev (local only) | google
# RAIA_DEV_USER_EMAIL=developer@raia.local
# RAIA_DEV_USER_NAME=Local developer
# RAIA_ADMIN_EMAILS=you@example.com
# Keyed participant codes for the research export; the export refuses to run without it.
# RAIA_PSEUDONYM_KEY=a-long-random-string
# Contact shown on the public Privacy & terms page (/privacy).
# RAIA_CONTACT_EMAIL=you@example.com
# RAIA_MAX_RUNS_PER_DAY=60

# --- Optional tuning ---------------------------------------------------------
# RAIA_LLM_MAX_TOKENS=16384
# Budget one retry may raise to when a reply was cut off at the limit.
# RAIA_LLM_MAX_TOKENS_CEILING=32000
# RAIA_WORKSPACE_DIR=./workspace
# Log each page run's duration and database round trips (diagnosing slowness).
# RAIA_PROFILE=1

# --- Reliability -------------------------------------------------------------
# Transient provider failures (overload, rate limit, timeout) are retried with
# backoff. Nothing else is retried.
RAIA_LLM_RETRIES=2
# Replies that do not validate against the RAIA record schema are sent back this many times.
RAIA_CONTRACT_REPAIRS=1

# Retrieval budget. Each agent additionally pins the excerpts its decision
# procedure depends on, so the decisive text is never dropped by similarity.
RAIA_RAG_TOP_K=12

# Optional Jira integration. Encrypts each person's Jira API token when they
# connect Jira in Settings; without it the token is kept for the session only.
# The board works without Jira.
# RAIA_JIRA_KEY=a-long-random-string

# Keeps the exact prompt and raw replies of every run, encrypted, so a past
# draft can be reproduced and audited. Without it only the prompt hash and the
# token use are kept. Comma-separated keys rotate: the first encrypts.
# RAIA_TRANSCRIPT_KEY=another-long-random-string
# RAIA_LOG_LEVEL=INFO
