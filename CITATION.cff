    given-names: "Diogo Luís"
    affiliation: "Universidade Presbiteriana Mackenzie"
version: "0.3.0"
license: MIT
repository-code: "https://github.com/DiogoCampanha/raia"
keywords:
  - responsible AI
  - AI governance
  - multi-agent systems
  - large language models
  - software development life cycle
  - EU AI Act
