{
  "$id": "raia-record/1.0/requirements_reviewer",
  "title": "RequirementsReviewerRecord",
  "$defs": {
    "Action": {
      "properties": {
        "id": {
          "description": "Local identifier such as A1. Code assigns the final id.",
          "title": "Id",
          "type": "string"
        },
        "finding_ids": {
          "description": "The finding ids (local) this action responds to.",
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "action": {
          "description": "Imperative, specific, checkable: what is done.",
          "maxLength": 400,
          "title": "Action",
          "type": "string"
        },
        "response": {
          "description": "Risk response (NIST AI RMF MANAGE 1).",
          "enum": [
            "mitigate",
            "transfer",
            "avoid",
            "accept"
          ],
          "title": "Response",
          "type": "string"
        },
        "owner_role": {
          "description": "The accountable role.",
          "enum": [
            "product",
            "engineering",
            "data_science",
            "legal_compliance",
            "operations",
            "leadership"
          ],
          "title": "Owner Role",
          "type": "string"
        },
        "lifecycle_stage": {
          "description": "Lifecycle stage in which it must be done.",
          "enum": [
            "plan_and_design",
            "collect_and_process_data",
            "build_and_use_model",
            "verify_and_validate",
            "deploy_and_use",
            "operate_and_monitor"
          ],
          "title": "Lifecycle Stage",
          "type": "string"
        },
        "review_cadence": {
          "description": "How often it is reviewed.",
          "enum": [
            "once",
            "every_sprint",
            "every_release",
            "continuous"
          ],
          "title": "Review Cadence",
          "type": "string"
        },
        "verification_method": {
          "description": "How completion is verified.",
          "enum": [
            "test",
            "audit",
            "measurement",
            "inspection"
          ],
          "title": "Verification Method",
          "type": "string"
        },
        "evidence_artifact": {
          "description": "The artifact that will demonstrate completion.",
          "maxLength": 200,
          "title": "Evidence Artifact",
          "type": "string"
        },
        "citations": {
          "description": "Citation tags copied exactly from the retrieved excerpts, e.g. \"[Source: ... | authority: legal]\". Never invent one.",
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "links": {
          "items": {
            "type": "string"
          },
          "title": "Links",
          "type": "array"
        },
        "priority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "computed": true,
          "default": null,
          "title": "Priority"
        }
      },
      "required": [
        "id",
        "finding_ids",
        "action",
        "response",
        "owner_role",
        "lifecycle_stage",
        "review_cadence",
        "verification_method",
        "evidence_artifact"
      ],
      "title": "Action",
      "type": "object"
    },
    "CoverageItem": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "status": {
          "enum": [
            "covered",
            "not-applicable",
            "not-grounded"
          ],
          "title": "Status",
          "type": "string"
        },
        "justification": {
          "description": "One sentence.",
          "maxLength": 300,
          "title": "Justification",
          "type": "string"
        }
      },
      "required": [
        "key",
        "status",
        "justification"
      ],
      "title": "CoverageItem",
      "type": "object"
    },
    "EthicalValueRequirement": {
      "properties": {
        "id": {
          "description": "An assigned EVR id, exactly.",
          "title": "Id",
          "type": "string"
        },
        "value": {
          "enum": [
            "accountability",
            "fairness",
            "human_oversight",
            "privacy",
            "robustness",
            "transparency",
            "wellbeing"
          ],
          "title": "Value",
          "type": "string"
        },
        "stakeholders": {
          "items": {
            "type": "string"
          },
          "title": "Stakeholders",
          "type": "array"
        },
        "statement": {
          "description": "The requirement, bound to this context of use.",
          "maxLength": 500,
          "title": "Statement",
          "type": "string"
        },
        "fit_criterion": {
          "description": "The measurable condition that settles whether it is met.",
          "maxLength": 400,
          "title": "Fit Criterion",
          "type": "string"
        },
        "verification_method": {
          "enum": [
            "test",
            "audit",
            "measurement",
            "inspection"
          ],
          "title": "Verification Method",
          "type": "string"
        },
        "traces_to": {
          "description": "Obligation codes or principle refs it derives from.",
          "items": {
            "type": "string"
          },
          "title": "Traces To",
          "type": "array"
        },
        "citations": {
          "description": "Citation tags copied exactly from the retrieved excerpts, e.g. \"[Source: ... | authority: legal]\". Never invent one.",
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "id",
        "value",
        "stakeholders",
        "statement",
        "fit_criterion",
        "verification_method"
      ],
      "title": "EthicalValueRequirement",
      "type": "object"
    },
    "Finding": {
      "properties": {
        "id": {
          "description": "Local identifier such as F1. Code assigns the final id.",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "description": "One line naming the risk or gap.",
          "maxLength": 160,
          "title": "Title",
          "type": "string"
        },
        "statement": {
          "description": "What could go wrong or is missing, for whom, and why it matters here.",
          "maxLength": 700,
          "title": "Statement",
          "type": "string"
        },
        "principle": {
          "description": "The Responsible AI principle at stake.",
          "enum": [
            "accountability",
            "fairness",
            "human_oversight",
            "privacy",
            "robustness",
            "transparency",
            "wellbeing"
          ],
          "title": "Principle",
          "type": "string"
        },
        "nist_category": {
          "description": "The NIST AI RMF category this finding belongs to.",
          "enum": [
            "GOVERN 1",
            "GOVERN 2",
            "GOVERN 3",
            "GOVERN 4",
            "GOVERN 5",
            "GOVERN 6",
            "MAP 1",
            "MAP 2",
            "MAP 3",
            "MAP 4",
            "MAP 5",
            "MEASURE 1",
            "MEASURE 2",
            "MEASURE 3",
            "MEASURE 4",
            "MANAGE 1",
            "MANAGE 2",
            "MANAGE 3",
            "MANAGE 4"
          ],
          "title": "Nist Category",
          "type": "string"
        },
        "magnitude": {
          "description": "Impact magnitude, using the anchored definitions.",
          "enum": [
            "negligible",
            "limited",
            "significant",
            "severe"
          ],
          "title": "Magnitude",
          "type": "string"
        },
        "likelihood": {
          "description": "Likelihood, using the anchored definitions.",
          "enum": [
            "rare",
            "possible",
            "likely",
            "observed"
          ],
          "title": "Likelihood",
          "type": "string"
        },
        "placement_rationale": {
          "description": "Why this magnitude and likelihood, from the inputs and evidence.",
          "maxLength": 400,
          "title": "Placement Rationale",
          "type": "string"
        },
        "stakeholders": {
          "description": "Who is affected, direct and indirect.",
          "items": {
            "type": "string"
          },
          "title": "Stakeholders",
          "type": "array"
        },
        "citations": {
          "description": "Citation tags copied exactly from the retrieved excerpts, e.g. \"[Source: ... | authority: legal]\". Never invent one.",
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "links": {
          "description": "Identifiers from the computed block this finding concerns (obligation codes, EVR ids, story ids, card ids, audit item ids, telemetry windows).",
          "items": {
            "type": "string"
          },
          "title": "Links",
          "type": "array"
        },
        "risk_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "computed": true,
          "default": null,
          "title": "Risk Level"
        },
        "priority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "computed": true,
          "default": null,
          "title": "Priority"
        },
        "blocking": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "computed": true,
          "default": null,
          "title": "Blocking"
        },
        "priority_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "computed": true,
          "default": null,
          "title": "Priority Basis"
        }
      },
      "required": [
        "id",
        "title",
        "statement",
        "principle",
        "nist_category",
        "magnitude",
        "likelihood",
        "placement_rationale"
      ],
      "title": "Finding",
      "type": "object"
    },
    "GapNote": {
      "properties": {
        "evr_id": {
          "description": "A computed EVR id, exactly.",
          "title": "Evr Id",
          "type": "string"
        },
        "explanation": {
          "description": "What is missing and why it matters for this product.",
          "maxLength": 600,
          "title": "Explanation",
          "type": "string"
        },
        "citations": {
          "description": "Citation tags copied exactly from the retrieved excerpts, e.g. \"[Source: ... | authority: legal]\". Never invent one.",
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "evr_id",
        "explanation"
      ],
      "title": "GapNote",
      "type": "object"
    },
    "HarmBenefit": {
      "properties": {
        "stakeholder": {
          "title": "Stakeholder",
          "type": "string"
        },
        "harms": {
          "maxLength": 400,
          "title": "Harms",
          "type": "string"
        },
        "benefits": {
          "maxLength": 400,
          "title": "Benefits",
          "type": "string"
        }
      },
      "required": [
        "stakeholder",
        "harms",
        "benefits"
      ],
      "title": "HarmBenefit",
      "type": "object"
    },
    "ImpactAssessment": {
      "properties": {
        "intended_uses": {
          "description": "Intended and out-of-scope uses.",
          "maxLength": 700,
          "title": "Intended Uses",
          "type": "string"
        },
        "harms_and_benefits": {
          "description": "Potential harms and benefits per stakeholder.",
          "items": {
            "$ref": "#/$defs/HarmBenefit"
          },
          "title": "Harms And Benefits",
          "type": "array"
        },
        "mitigations": {
          "maxLength": 700,
          "title": "Mitigations",
          "type": "string"
        }
      },
      "required": [
        "intended_uses",
        "mitigations"
      ],
      "title": "ImpactAssessment",
      "type": "object"
    },
    "OpenIssue": {
      "properties": {
        "id": {
          "default": "",
          "description": "Local identifier such as I1.",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "normative_conflict",
            "engine_disagreement",
            "value_tradeoff",
            "not_grounded",
            "missing_information",
            "risk_acceptance",
            "prohibited_practice"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "maxLength": 700,
          "title": "Description",
          "type": "string"
        },
        "options": {
          "description": "The choices a person could make.",
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "decision_owner": {
          "description": "The role that must arbitrate.",
          "enum": [
            "product",
            "engineering",
            "data_science",
            "legal_compliance",
            "operations",
            "leadership"
          ],
          "title": "Decision Owner",
          "type": "string"
        },
        "blocking": {
          "default": false,
          "description": "True if work must not proceed until decided.",
          "title": "Blocking",
          "type": "boolean"
        },
        "links": {
          "items": {
            "type": "string"
          },
          "title": "Links",
          "type": "array"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "computed": true,
          "default": "agent",
          "title": "Origin"
        }
      },
      "required": [
        "type",
        "description",
        "decision_owner"
      ],
      "title": "OpenIssue",
      "type": "object"
    },
    "RequirementsReviewExt": {
      "properties": {
        "context_of_use": {
          "description": "The operational environment and conditions of use (IEEE 7000 concept of operations).",
          "maxLength": 900,
          "title": "Context Of Use",
          "type": "string"
        },
        "stakeholders": {
          "description": "Direct and indirect stakeholders and the values at stake for each.",
          "items": {
            "$ref": "#/$defs/StakeholderEntry"
          },
          "title": "Stakeholders",
          "type": "array"
        },
        "value_register": {
          "description": "Prioritised core values with threats and opportunities (IEEE 7000 Value Register).",
          "items": {
            "$ref": "#/$defs/ValueEntry"
          },
          "title": "Value Register",
          "type": "array"
        },
        "gap_analysis": {
          "description": "One entry per computed EVR id.",
          "items": {
            "$ref": "#/$defs/GapNote"
          },
          "title": "Gap Analysis",
          "type": "array"
        },
        "evrs": {
          "description": "One ethical value requirement per assigned id.",
          "items": {
            "$ref": "#/$defs/EthicalValueRequirement"
          },
          "title": "Evrs",
          "type": "array"
        },
        "impact_assessment": {
          "$ref": "#/$defs/ImpactAssessment",
          "description": "Microsoft RAI Standard v2 goal A1 impact assessment."
        }
      },
      "required": [
        "context_of_use",
        "impact_assessment"
      ],
      "title": "RequirementsReviewExt",
      "type": "object"
    },
    "StakeholderEntry": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "description": "direct (uses the system) or indirect (affected without using it).",
          "enum": [
            "direct",
            "indirect"
          ],
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "enum": [
              "accountability",
              "fairness",
              "human_oversight",
              "privacy",
              "robustness",
              "transparency",
              "wellbeing"
            ],
            "type": "string"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "StakeholderEntry",
      "type": "object"
    },
    "ValueEntry": {
      "properties": {
        "value": {
          "description": "The core value.",
          "enum": [
            "accountability",
            "fairness",
            "human_oversight",
            "privacy",
            "robustness",
            "transparency",
            "wellbeing"
          ],
          "title": "Value",
          "type": "string"
        },
        "rank": {
          "description": "1 = highest priority core value.",
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "threats": {
          "description": "How the design could harm this value.",
          "maxLength": 500,
          "title": "Threats",
          "type": "string"
        },
        "opportunities": {
          "description": "How the design could advance it.",
          "maxLength": 500,
          "title": "Opportunities",
          "type": "string"
        }
      },
      "required": [
        "value",
        "rank",
        "threats",
        "opportunities"
      ],
      "title": "ValueEntry",
      "type": "object"
    }
  },
  "properties": {
    "summary": {
      "description": "The bottom line a reviewer reads first; at most five sentences.",
      "maxLength": 1200,
      "title": "Summary",
      "type": "string"
    },
    "overall_status": {
      "enum": [
        "on_track",
        "needs_attention",
        "blocked"
      ],
      "title": "Overall Status",
      "type": "string"
    },
    "declared_verdict": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Your value for each verdict key named in the contract.",
      "title": "Declared Verdict",
      "type": "object"
    },
    "agrees_with_rule_engine": {
      "title": "Agrees With Rule Engine",
      "type": "boolean"
    },
    "disagreement_rationale": {
      "default": "",
      "description": "Required when you disagree.",
      "title": "Disagreement Rationale",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "title": "Actions",
      "type": "array"
    },
    "open_issues": {
      "description": "Issues you raise. The rule engine's issues are carried forward by code; do not repeat them.",
      "items": {
        "$ref": "#/$defs/OpenIssue"
      },
      "title": "Open Issues",
      "type": "array"
    },
    "not_grounded": {
      "description": "Claims you believe matter that the retrieved excerpts do not support.",
      "items": {
        "type": "string"
      },
      "title": "Not Grounded",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/CoverageItem"
      },
      "title": "Coverage",
      "type": "array"
    },
    "extension": {
      "$ref": "#/$defs/RequirementsReviewExt"
    }
  },
  "required": [
    "summary",
    "overall_status",
    "agrees_with_rule_engine",
    "extension"
  ],
  "type": "object"
}
