{
  "$id": "raia-record/1.2/risk_classifier",
  "title": "RiskClassifierRecord",
  "$defs": {
    "Action": {
      "properties": {
        "id": {
          "description": "Local identifier such as A1. Code assigns the final id.",
          "title": "Id",
          "type": "string"
        },
        "finding_ids": {
          "description": "The finding ids (local) this action responds to.",
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "action": {
          "description": "One sentence starting with a verb: what is done, specific and checkable.",
          "maxLength": 250,
          "title": "Action",
          "type": "string"
        },
        "response": {
          "description": "Risk response (NIST AI RMF MANAGE 1).",
          "enum": [
            "mitigate",
            "transfer",
            "avoid",
            "accept"
          ],
          "title": "Response",
          "type": "string"
        },
        "owner_role": {
          "description": "The accountable role.",
          "enum": [
            "product",
            "engineering",
            "data_science",
            "legal_compliance",
            "operations",
            "leadership"
          ],
          "title": "Owner Role",
          "type": "string"
        },
        "lifecycle_stage": {
          "description": "Lifecycle stage in which it must be done.",
          "enum": [
            "plan_and_design",
            "collect_and_process_data",
            "build_and_use_model",
            "verify_and_validate",
            "deploy_and_use",
            "operate_and_monitor"
          ],
          "title": "Lifecycle Stage",
          "type": "string"
        },
        "review_cadence": {
          "description": "How often it is reviewed.",
          "enum": [
            "once",
            "every_sprint",
            "every_release",
            "continuous"
          ],
          "title": "Review Cadence",
          "type": "string"
        },
        "verification_method": {
          "description": "How completion is verified.",
          "enum": [
            "test",
            "audit",
            "measurement",
            "inspection"
          ],
          "title": "Verification Method",
          "type": "string"
        },
        "evidence_artifact": {
          "description": "The artifact that will demonstrate completion, named concretely.",
          "maxLength": 150,
          "title": "Evidence Artifact",
          "type": "string"
        },
        "citations": {
          "description": "Citation tags copied exactly from the retrieved excerpts, e.g. \"[Source: ... | authority: legal]\". Never invent one.",
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "links": {
          "items": {
            "type": "string"
          },
          "title": "Links",
          "type": "array"
        },
        "priority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "computed": true,
          "default": null,
          "title": "Priority"
        }
      },
      "required": [
        "id",
        "finding_ids",
        "action",
        "response",
        "owner_role",
        "lifecycle_stage",
        "review_cadence",
        "verification_method",
        "evidence_artifact"
      ],
      "title": "Action",
      "type": "object"
    },
    "CoverageItem": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "status": {
          "enum": [
            "covered",
            "not-applicable",
            "not-grounded"
          ],
          "title": "Status",
          "type": "string"
        },
        "justification": {
          "description": "One short sentence.",
          "maxLength": 200,
          "title": "Justification",
          "type": "string"
        }
      },
      "required": [
        "key",
        "status",
        "justification"
      ],
      "title": "CoverageItem",
      "type": "object"
    },
    "Finding": {
      "properties": {
        "id": {
          "description": "Local identifier such as F1. Code assigns the final id.",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "description": "The risk or gap in a few words (at most 12).",
          "maxLength": 120,
          "title": "Title",
          "type": "string"
        },
        "statement": {
          "description": "One or two sentences: what could go wrong or is missing, for whom, here.",
          "maxLength": 400,
          "title": "Statement",
          "type": "string"
        },
        "principle": {
          "description": "The Responsible AI principle at stake.",
          "enum": [
            "accountability",
            "fairness",
            "human_oversight",
            "privacy",
            "robustness",
            "transparency",
            "wellbeing"
          ],
          "title": "Principle",
          "type": "string"
        },
        "nist_category": {
          "description": "The NIST AI RMF category this finding belongs to.",
          "enum": [
            "GOVERN 1",
            "GOVERN 2",
            "GOVERN 3",
            "GOVERN 4",
            "GOVERN 5",
            "GOVERN 6",
            "MAP 1",
            "MAP 2",
            "MAP 3",
            "MAP 4",
            "MAP 5",
            "MEASURE 1",
            "MEASURE 2",
            "MEASURE 3",
            "MEASURE 4",
            "MANAGE 1",
            "MANAGE 2",
            "MANAGE 3",
            "MANAGE 4"
          ],
          "title": "Nist Category",
          "type": "string"
        },
        "magnitude": {
          "description": "Impact magnitude, using the anchored definitions.",
          "enum": [
            "negligible",
            "limited",
            "significant",
            "severe"
          ],
          "title": "Magnitude",
          "type": "string"
        },
        "likelihood": {
          "description": "Likelihood, using the anchored definitions.",
          "enum": [
            "rare",
            "possible",
            "likely",
            "observed"
          ],
          "title": "Likelihood",
          "type": "string"
        },
        "placement_rationale": {
          "description": "One sentence: why this magnitude and likelihood.",
          "maxLength": 250,
          "title": "Placement Rationale",
          "type": "string"
        },
        "stakeholders": {
          "description": "Who is affected, direct and indirect.",
          "items": {
            "type": "string"
          },
          "title": "Stakeholders",
          "type": "array"
        },
        "citations": {
          "description": "Citation tags copied exactly from the retrieved excerpts, e.g. \"[Source: ... | authority: legal]\". Never invent one.",
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "links": {
          "description": "Identifiers from the computed block this finding concerns (obligation codes, EVR ids, story ids, card ids, audit item ids, telemetry windows).",
          "items": {
            "type": "string"
          },
          "title": "Links",
          "type": "array"
        },
        "risk_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "computed": true,
          "default": null,
          "title": "Risk Level"
        },
        "priority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "computed": true,
          "default": null,
          "title": "Priority"
        },
        "blocking": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "computed": true,
          "default": null,
          "title": "Blocking"
        },
        "priority_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "computed": true,
          "default": null,
          "title": "Priority Basis"
        }
      },
      "required": [
        "id",
        "title",
        "statement",
        "principle",
        "nist_category",
        "magnitude",
        "likelihood",
        "placement_rationale"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ObligationNote": {
      "properties": {
        "code": {
          "description": "An obligation code from the computed table, exactly.",
          "title": "Code",
          "type": "string"
        },
        "meaning_for_this_product": {
          "description": "One sentence: what the team must do or show for this product.",
          "maxLength": 300,
          "title": "Meaning For This Product",
          "type": "string"
        },
        "citations": {
          "description": "Citation tags copied exactly from the retrieved excerpts, e.g. \"[Source: ... | authority: legal]\". Never invent one.",
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "code",
        "meaning_for_this_product"
      ],
      "title": "ObligationNote",
      "type": "object"
    },
    "OpenIssue": {
      "properties": {
        "id": {
          "default": "",
          "description": "Local identifier such as I1.",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "normative_conflict",
            "engine_disagreement",
            "value_tradeoff",
            "not_grounded",
            "missing_information",
            "risk_acceptance",
            "prohibited_practice"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "description": "The decision a person must take, in one or two sentences.",
          "maxLength": 400,
          "title": "Description",
          "type": "string"
        },
        "options": {
          "description": "The choices a person could make, a few words each.",
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "decision_owner": {
          "description": "The role that must arbitrate.",
          "enum": [
            "product",
            "engineering",
            "data_science",
            "legal_compliance",
            "operations",
            "leadership"
          ],
          "title": "Decision Owner",
          "type": "string"
        },
        "blocking": {
          "default": false,
          "description": "True if work must not proceed until decided.",
          "title": "Blocking",
          "type": "boolean"
        },
        "links": {
          "items": {
            "type": "string"
          },
          "title": "Links",
          "type": "array"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "computed": true,
          "default": "agent",
          "title": "Origin"
        }
      },
      "required": [
        "type",
        "description",
        "decision_owner"
      ],
      "title": "OpenIssue",
      "type": "object"
    },
    "RiskClassificationExt": {
      "properties": {
        "prohibited_screen": {
          "description": "Result of the EU AI Act Art. 5 and PL 2338 excessive-risk screen, conclusion first.",
          "maxLength": 400,
          "title": "Prohibited Screen",
          "type": "string"
        },
        "eu_tier_justification": {
          "description": "Why the EU tier holds, naming the area or article; at most two sentences.",
          "maxLength": 400,
          "title": "Eu Tier Justification",
          "type": "string"
        },
        "br_tier_justification": {
          "description": "Why the Brazilian tier holds, naming the area; at most two sentences.",
          "maxLength": 400,
          "title": "Br Tier Justification",
          "type": "string"
        },
        "obligations": {
          "description": "One note per computed obligation code.",
          "items": {
            "$ref": "#/$defs/ObligationNote"
          },
          "title": "Obligations",
          "type": "array"
        },
        "human_oversight_assessment": {
          "description": "Whether the declared oversight design meets the oversight obligations, conclusion first.",
          "maxLength": 450,
          "title": "Human Oversight Assessment",
          "type": "string"
        },
        "affected_persons_rights": {
          "description": "How affected persons' rights are operationalised in the product, conclusion first.",
          "maxLength": 450,
          "title": "Affected Persons Rights",
          "type": "string"
        },
        "impact_assessments": {
          "description": "Which impact assessments the instruments require (fundamental rights / algorithmic).",
          "maxLength": 400,
          "title": "Impact Assessments",
          "type": "string"
        }
      },
      "required": [
        "prohibited_screen",
        "eu_tier_justification",
        "br_tier_justification",
        "human_oversight_assessment",
        "affected_persons_rights",
        "impact_assessments"
      ],
      "title": "RiskClassificationExt",
      "type": "object"
    }
  },
  "properties": {
    "headline": {
      "default": "",
      "description": "The bottom line in ONE sentence of at most 25 words a busy reader can act on: the verdict and what it means for the team.",
      "maxLength": 200,
      "model_required": true,
      "title": "Headline",
      "type": "string"
    },
    "summary": {
      "description": "At most three sentences that add to the headline: the main risks and what must happen next. No framework explanations.",
      "maxLength": 600,
      "title": "Summary",
      "type": "string"
    },
    "overall_status": {
      "enum": [
        "on_track",
        "needs_attention",
        "blocked"
      ],
      "title": "Overall Status",
      "type": "string"
    },
    "declared_verdict": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Your value for each verdict key named in the contract.",
      "title": "Declared Verdict",
      "type": "object"
    },
    "agrees_with_rule_engine": {
      "title": "Agrees With Rule Engine",
      "type": "boolean"
    },
    "disagreement_rationale": {
      "default": "",
      "description": "Required when you disagree.",
      "title": "Disagreement Rationale",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "title": "Actions",
      "type": "array"
    },
    "open_issues": {
      "description": "Issues you raise. The rule engine's issues are carried forward by code; do not repeat them.",
      "items": {
        "$ref": "#/$defs/OpenIssue"
      },
      "title": "Open Issues",
      "type": "array"
    },
    "not_grounded": {
      "description": "Claims you believe matter that the retrieved excerpts do not support.",
      "items": {
        "type": "string"
      },
      "title": "Not Grounded",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/CoverageItem"
      },
      "title": "Coverage",
      "type": "array"
    },
    "extension": {
      "$ref": "#/$defs/RiskClassificationExt"
    }
  },
  "required": [
    "summary",
    "overall_status",
    "agrees_with_rule_engine",
    "extension"
  ],
  "type": "object"
}
