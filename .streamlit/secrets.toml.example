# RAIA — deployment configuration
# ================================
#
# On Streamlit Community Cloud you do NOT need this file: paste the same
# content into the app's Secrets box instead
# (share.streamlit.io -> your app -> ... -> Settings -> Secrets -> Save).
# The app restarts by itself; no redeploy and no code change are needed.
#
# Locally, copy this file to `.streamlit/secrets.toml` (git-ignored) if you
# prefer it over a `.env` file. Environment variables always win over
# secrets, so an existing `.env` keeps working unchanged.

# --- The only required line -------------------------------------------------
ANTHROPIC_API_KEY = "sk-ant-..."

# All of these are accepted as the same thing, in case you type it from
# memory: anthropic_api_key / CLAUDE_API_KEY / LLM_API_KEY, or a section:
#
#   [anthropic]
#   api_key = "sk-ant-..."
#
# An OPENAI_API_KEY on its own also works -- the provider switches to
# OpenAI automatically.

# --- Projects and sign-in (required for a shared, persistent deployment) -----
# The database that keeps users, projects and every artifact across restarts.
# Paste the Neon connection string (Dashboard -> Connect). Prefer the direct
# (non "-pooler") host.
# RAIA_DATABASE_URL = "postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
#
# Google sign-in, handled by Streamlit. RAIA never sees a password.
# [auth]
# redirect_uri = "https://<your-app>.streamlit.app/oauth2callback"
# cookie_secret = "<a long random string>"
# client_id = "<from Google Cloud Console>"
# client_secret = "<from Google Cloud Console>"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
#
# Who may download the pseudonymized research dataset (comma-separated).
# RAIA_ADMIN_EMAILS = "you@example.com"
# A long random string; keeps participant codes stable across exports.
# RAIA_PSEUDONYM_KEY = "<another long random string>"
# Contact shown on the public Privacy Policy and User Agreement page, which is
# served at https://<your-app>/privacy — use that URL on Google's OAuth consent screen.
# RAIA_CONTACT_EMAIL = "you@example.com"
# Model calls per person per day (0 = unlimited).
# RAIA_MAX_RUNS_PER_DAY = "60"

# --- Optional overrides -----------------------------------------------------
# RAIA_LLM_MODEL       = "claude-sonnet-4-5"  # any Claude / GPT model id
# RAIA_LLM_PROVIDER    = "anthropic"          # "anthropic" | "openai" | "mock"
# RAIA_LLM_TEMPERATURE = "0.2"
# RAIA_RAG_TOP_K       = "6"
#
# "mock" produces canned agent outputs with no model call. It is an explicit
# choice, never an automatic fallback: without a usable key the app shows a
# "not configured" screen rather than serving placeholder text that a tester
# could mistake for a real analysis.
